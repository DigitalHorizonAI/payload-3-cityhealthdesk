# Database connection string
DATABASE_URI=postgres://postgres:postgres@localhost:5432/<your-db-name>

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public address the site is served from, as visitors and Google see it.
# Canonical URLs, Open Graph tags and the sitemap all use this, and robots.txt
# only allows indexing on this exact host - so any other hostname the app answers
# on (www, the *.up.railway.app host) is served `Disallow: /` on purpose.
# The full site launched on the apex on 14 Aug 2026, so that is the value now.
# No trailing slash: every consumer concatenates ${SITE_URL}/path.
# Read at build time - changing it needs a REBUILD, not a restart.
# Leave unset for local development - it falls back to NEXT_PUBLIC_SERVER_URL.
NEXT_PUBLIC_SITE_URL=https://cityhealthdesk.com
